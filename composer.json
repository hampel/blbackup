{
    "name": "hampel/blbackup",
    "description": "BinaryLane VPS backup: temporary snapshots taken through the API, downloaded as compressed disk images, verified, shipped to cloud storage and expired.",
    "keywords": ["backup", "binarylane", "vps", "rclone", "zstd", "console", "cli"],
    "homepage": "https://github.com/hampel/blbackup",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/hampel/blbackup/issues",
        "source": "https://github.com/hampel/blbackup"
    },
    "authors": [
        {
            "name": "Simon Hampel",
            "email": "simon@hampelgroup.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "hampel/binarylane-api-laravel": "^0.7",
        "hampel/console-report": "^2.1",
        "hampel/slack-message": "^2.2",
        "illuminate/http": "^13.0",
        "illuminate/log": "^13.0",
        "laravel-zero/framework": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.22",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.8.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "build": [
            "@composer install --no-dev --no-interaction",
            "@php blbackup app:build blbackup",
            "@composer install --no-interaction",
            "if grep -aq 'laravel/pint' builds/blbackup; then echo 'ERROR: the build contains dev dependencies - do not release it'; exit 1; fi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["blbackup"]
}
