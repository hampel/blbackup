# Configuration for blbackup. Copy to .env and set what you need.
#
# A commented-out setting shows the DEFAULT it takes when left unset, so an
# install only has to name the token, the download path and the remote. Where
# that is not possible - a required setting, or one derived at runtime - the line
# is marked EXAMPLE and the comment above it says what the default really is.
# Three lines used to show an example without saying so, and one of them cost an
# afternoon: LOCK_FILE read as though the lock was already on a shared mount.
#
# `blbackup app:config` prints what a given install actually resolved to, which
# is the way to check this file took effect - particularly for a compiled
# binary, where the .env has to sit beside it (see LARAVEL_STORAGE_PATH below).

# BinaryLane API token. Required - everything but `check`, `move` and `clean`
# needs it. Create one under API Access in the BinaryLane control panel; it needs
# read access plus permission to take server backups.
# `blbackup account` is the cheapest way to confirm it works.
BINARYLANE_API_TOKEN=

# Timezone for datestamps in downloaded filenames, for the local-time column in
# `blbackup backups`, and for log records.
# Read as binarylane.timezone rather than app.timezone: app:build evaluates
# config/app.php on the build machine and compiles the result in as literals, so
# an env() call in that file freezes at build time whatever a .env beside the
# binary says. This one works in a built binary.
#APP_TIMEZONE=UTC

# Where downloaded backup images are written. Each server gets a directory named
# after its hostname beneath this one.
# Relative values resolve against the working directory, which under cron is
# whatever the crontab last changed to - use an absolute path on a server. Needs
# room for a full uncompressed-size image per server being kept.
#DOWNLOAD_PATH=storage/backups

# Seconds to wait before giving up. Used twice: as the HTTP timeout on a download,
# and as the ceiling on how long `create` will poll for a server backup to finish.
# Multi-hundred-GB servers can exceed an hour on both counts.
# Note this does not bound `wget`, `zstd` or `rclone`, which are run without a
# timeout because the files are large enough to make any limit a false failure.
#DOWNLOAD_TIMEOUT=3600

# Days to keep local backups. `blbackup clean` deletes anything older, judged by
# file modification time, and with --remote applies the same cutoff to the rclone
# remote. Override for one run with `clean --days=N`.
#KEEPONLY_DAYS=7

# Where the backup lock lives. One lock covers every command that writes, so a
# run that overruns holds the next one off rather than running over the top of
# it - a multi-gigabyte image on a slow link is exactly the case. Held by flock
# for the life of the process, so a killed run leaves nothing to clean up.
#
# In a container this MUST be moved onto a shared mount - EXAMPLE:
# LOCK_FILE=/logs/blbackup.lock. Each `docker compose run` gets its own
# filesystem, so the default below is a lock two concurrent runs cannot see each
# other holding: it does nothing, and nothing says so.
#LOCK_FILE=storage/blbackup.lock

# The three binaries below are inserted into the command line as written, so they
# may carry options of their own - eg:
#
#     RCLONE_BINARY="/usr/bin/rclone --config /etc/rclone.conf"
#
# which is the tidiest way to point rclone at a config file when the backups run
# as a user without one of its own. They must never be built out of anything but
# your own configuration.

# Path to wget, which is what downloads images by default.
#WGET_BINARY=/usr/bin/wget

# Path to zstd, used by `check` to verify a downloaded image decompresses. A
# download that fails this test is deleted rather than kept.
#ZSTD_BINARY=/usr/bin/zstd

# Path to rclone, used by `move` to ship images to secondary storage and by
# `clean --remote` to expire them there.
#RCLONE_BINARY=/usr/bin/rclone

# EXAMPLE - there is no default. rclone remote for secondary storage, as
# "remote:path_prefix". Required for
# `move` and for `clean --remote`; without it `move` fails rather than silently
# keeping files local. It is also what `cron` reads to decide whether a nightly
# run moves its downloads away at all - unset it on an installation that runs on
# the machine keeping the backups, and the run downloads and stops there.
#
# The local directory layout is reproduced beneath the prefix, so
# `download --move` can tell an image already shipped from one still to fetch.
# Override for one run with `move --remote=...`.
# `rclone listremotes` names the configured remotes.
#RCLONE_REMOTE=backups:blbackup

# Logging is OFF by default. LOG_CHANNEL is "stack", but the stack writes to the
# channels named in LOG_STACK, and that defaults to "null" - which discards
# everything. A server install wants LOG_STACK set, or a failed overnight backup
# leaves no trace. `blbackup app:validate` writes a record at every level, which
# is the check that this took - and, if a Slack webhook is configured below, it
# posts. That is the point: a revoked webhook is invisible from this end.

# Log channel: single, daily, stack, slack, syslog, errorlog, stderr, null
#LOG_CHANNEL=stack

# Channels the "stack" channel writes to, comma separated. Defaults to "null",
# which throws every record away - EXAMPLE of a real setting: single,slack
#LOG_STACK=null

# Log file for the single and daily channels
#LOG_STORAGE_PATH=storage/blbackup.log

# Log level for the single and daily channels
#LOG_LEVEL=debug

# Days of rotated log files kept by the daily channel
#LOG_DAILY_DAYS=14

# What this machine calls itself in the logs. Stamped onto every record, so one
# webhook can serve more than one installation - the alert says which host
# raised it. Defaults to the system hostname, which inside a container is a hex
# string that changes with every image rebuild, so it is worth setting here.
# Set it to an empty value to leave records unstamped, which is not the same as
# leaving it commented out.
# EXAMPLE - the default is whatever gethostname() returns.
#LOG_HOSTNAME=unraid

# Slack incoming webhook for log records. A log channel posts a record at a time,
# so it can only ever report trouble - a working backup and an uninstalled cron
# entry are equally silent.
#LOG_SLACK_WEBHOOK_URL=

# Name Slack posts are made under, and the emoji shown beside it. The name also
# appears in the footer of each message. Defaults to LOG_HOSTNAME.
#LOG_SLACK_USERNAME=
#LOG_SLACK_EMOJI=:boom:

# Log level at which records are posted to Slack
#LOG_SLACK_LEVEL=critical

# Slack incoming webhook for the run summary: one message per run saying whether
# the backup worked. Different from the log channel above and complementary to
# it - a log channel posts a record at a time and so can only ever report
# trouble, which makes a working backup and an uninstalled cron entry equally
# silent. Leave empty and nothing is sent. The same webhook can serve both.
#BLBACKUP_SUMMARY_SLACK_WEBHOOK=

# When to send the summary: "always" or "failure". "failure" buys quiet at the
# cost of that silence meaning nothing again.
#BLBACKUP_SUMMARY_NOTIFY=always

# Storage path: what the relative defaults above are resolved against, and where
# logs are written. Defaults to the project directory when running from source,
# and to the WORKING DIRECTORY when running as a compiled binary - so set it if a
# binary on the path is to be run from anywhere, and particularly under cron,
# where the working directory is wherever the crontab last changed to.
#
# This file is a separate question: a compiled binary reads .env from the
# directory holding the binary, not from the working directory and not from here.
# Keep .env beside the binary. `blbackup app:config` reports what each path
# actually resolved to, which is the way to check.
# Set it here or in the environment; both work.
#LARAVEL_STORAGE_PATH=
