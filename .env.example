# Configuration for blbackup. Copy to .env and set what you need - every setting
# below is shown with the default it takes when left unset, so an install only
# has to name the token, the download path and the remote.
#
# `blbackup app:config` prints what a given install actually resolved to, which
# is the way to check this file took effect - particularly for a compiled
# binary, where the .env has to sit beside it (see LARAVEL_STORAGE_PATH below).

# BinaryLane API token. Required - everything but `check`, `move` and `clean`
# needs it. Create one under API Access in the BinaryLane control panel; it needs
# read access plus permission to take server backups.
# `blbackup account` is the cheapest way to confirm it works.
BINARYLANE_API_TOKEN=

# Timezone for datestamps in downloaded filenames, for the local-time column in
# `blbackup backups`, and for log records.
# Read as binarylane.timezone rather than app.timezone: app:build evaluates
# config/app.php on the build machine and compiles the result in as literals, so
# an env() call in that file freezes at build time whatever a .env beside the
# binary says. This one works in a built binary.
#APP_TIMEZONE=UTC

# Where downloaded backup images are written. Each server gets a directory named
# after its hostname beneath this one.
# Relative values resolve against the working directory, which under cron is
# whatever the crontab last changed to - use an absolute path on a server. Needs
# room for a full uncompressed-size image per server being kept.
#DOWNLOAD_PATH=storage/backups

# Seconds to wait before giving up. Used twice: as the HTTP timeout on a download,
# and as the ceiling on how long `create` will poll for a server backup to finish.
# Multi-hundred-GB servers can exceed an hour on both counts.
# Note this does not bound `wget`, `zstd` or `rclone`, which are run without a
# timeout because the files are large enough to make any limit a false failure.
#DOWNLOAD_TIMEOUT=3600

# Days to keep local backups. `blbackup clean` deletes anything older, judged by
# file modification time, and with --remote applies the same cutoff to the rclone
# remote. Override for one run with `clean --days=N`.
#KEEPONLY_DAYS=7

# The three binaries below are inserted into the command line as written, so they
# may carry options of their own - eg:
#
#     RCLONE_BINARY="/usr/bin/rclone --config /etc/rclone.conf"
#
# which is the tidiest way to point rclone at a config file when the backups run
# as a user without one of its own. They must never be built out of anything but
# your own configuration.

# Path to wget, which is what downloads images by default.
#WGET_BINARY=/usr/bin/wget

# Path to zstd, used by `check` to verify a downloaded image decompresses. A
# download that fails this test is deleted rather than kept.
#ZSTD_BINARY=/usr/bin/zstd

# Path to rclone, used by `move` to ship images to secondary storage and by
# `clean --remote` to expire them there.
#RCLONE_BINARY=/usr/bin/rclone

# rclone remote for secondary storage, as "remote:path_prefix". Required for
# `move` and for `clean --remote`; without it `move` fails rather than silently
# keeping files local. The local directory layout is reproduced beneath the
# prefix, so `download --move` can tell an image already shipped from one still
# to fetch. Override for one run with `move --remote=...`.
# `rclone listremotes` names the configured remotes.
#RCLONE_REMOTE=backups:blbackup

# Logging is OFF by default - the default channel is "null", which discards
# everything. A server install wants a channel set, or a failed overnight backup
# leaves no trace. `blbackup app:test --logs` writes one record at every level
# and then dumps the resolved logging config, which is the check that it took.

# Log channel: single, daily, stack, slack, syslog, errorlog, stderr, null
#LOG_CHANNEL=daily

# Channels the "stack" channel writes to, comma separated
#LOG_STACK=daily,slack

# Log file for the single and daily channels
#LOG_STORAGE_PATH=storage/blbackup.log

# Log level for the single and daily channels
#LOG_LEVEL=debug

# Days of rotated log files kept by the daily channel
#LOG_DAILY_DAYS=14

# Slack incoming webhook for log records. A log channel posts a record at a time,
# so it can only ever report trouble - a working backup and an uninstalled cron
# entry are equally silent.
#LOG_SLACK_WEBHOOK_URL=

# Name Slack posts are made under, and the emoji shown beside it
#LOG_SLACK_USERNAME=Laravel Log
#LOG_SLACK_EMOJI=:boom:

# Log level at which records are posted to Slack
#LOG_SLACK_LEVEL=critical

# Storage path, which is what the defaults above are relative to and where a
# compiled binary looks for this file. Defaults to the project directory when
# running from source, and to the working directory when running as a PHAR - so
# set this if a binary on the path needs to be run from anywhere.
# Set it here or in the environment; both work.
#LARAVEL_STORAGE_PATH=
